{
  "manifest_version": 3,
  "name": "Pluno WebMCP for Anything",
  "version": "0.1.8",
  "description": "Exposes callable Pluno browser tools while Claude/Codex uses external Chrome.",
  "permissions": ["debugger", "scripting", "storage", "tabs", "alarms"],
  "host_permissions": ["<all_urls>", "https://app.pluno.ai/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Pluno WebMCP status",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["debugger-monitor.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
